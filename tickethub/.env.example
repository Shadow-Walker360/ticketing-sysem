# Copy to .env and adjust.
PORT=3000
DATABASE_URL=postgres://tickethub:tickethub@localhost:5432/tickethub
# Required when NODE_ENV=production. Use a long random value.
JWT_SECRET=change-me
# How long seats stay held while the user pays (seconds).
HOLD_SECONDS=300
# How long the seat map is cached in memory (milliseconds).
SEAT_MAP_TTL_MS=2000
RATE_LIMIT_PER_MINUTE=600
DB_POOL_SIZE=20
# Number of reverse proxies in front of the app (for correct client IPs).
TRUST_PROXY_HOPS=0
